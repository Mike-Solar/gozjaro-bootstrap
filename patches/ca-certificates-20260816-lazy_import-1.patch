# Gozjaro in-tree patch: ca-certificates 20260816 (Debian native source)
#
# Makes python3-cryptography OPTIONAL for certdata2pem.py. Upstream Debian
# lists it in Build-Depends-Indep, but the script uses it for exactly one
# thing: a log-only expired-certificate notice. PEM generation is pure
# stdlib base64, so with cryptography absent the .crt output is unchanged.
#
# Verified byte-identical 2026-10-19: 121 certs generated with and without
# cryptography diff clean against each other and against Debian's own
# pre-generated .deb payload (also 121). In the LFS chroot cryptography is
# simply not installed; the notice is skipped — a verified-equivalent build
# mode, not a workaround of a failure.
#
# Delivered repo-local: stage 20 copies patches/*.patch into $SOURCES_DIR
# (this patch has no upstream URL to download).
# Apply: patch -Np1 (from the ca-certificates/ top dir)
--- a/mozilla/certdata2pem.py	2026-10-19 02:02:47
+++ b/mozilla/certdata2pem.py	2026-10-19 02:02:47
@@ -28,7 +28,10 @@
 import textwrap
 import io
 
-from cryptography import x509
+try:
+    from cryptography import x509
+except ImportError:
+    x509 = None
 
 
 objects = []
@@ -122,11 +125,12 @@
         if not obj['CKA_LABEL'] in trust or not trust[obj['CKA_LABEL']]:
             continue
 
-        cert = x509.load_der_x509_certificate(bytes(obj['CKA_VALUE']))
-        if cert.not_valid_after < datetime.datetime.utcnow():
-            print('!'*74)
-            print('Trusted but expired certificate found: %s' % obj['CKA_LABEL'])
-            print('!'*74)
+        if x509 is not None:
+            cert = x509.load_der_x509_certificate(bytes(obj['CKA_VALUE']))
+            if cert.not_valid_after < datetime.datetime.utcnow():
+                print('!'*74)
+                print('Trusted but expired certificate found: %s' % obj['CKA_LABEL'])
+                print('!'*74)
 
         bname = obj['CKA_LABEL'][1:-1].replace('/', '_')\
                                       .replace(' ', '_')\
